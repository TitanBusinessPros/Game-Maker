rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // maps/{uid}/{mapId}/<file> - only the owning anonymous-auth user can
    // upload into their own folder; anyone can read (published games need
    // to load the art/sound without the viewer being signed in). 15MB cap
    // per file is generous for sprites/mp3s and keeps a bad upload cheap.
    match /maps/{uid}/{mapId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 15 * 1024 * 1024;
    }

    // Shared asset library (existing After Earth art/sound plus whatever
    // the admin adds later, so people can pick a ready-made sprite instead
    // of uploading their own). Public read; write locked to one specific
    // signed-in admin account, checked off the ID token itself.
    match /library/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'adonai4you@gmail.com'
                   && request.auth.token.email_verified == true
                   && request.resource.size < 20 * 1024 * 1024;
    }

    // Premium Library (admin.html's own ?premium=1 mode) - same public-
    // read/admin-only-write shape as library/ above. Reading the raw
    // file itself is intentionally not gated on whether a given account
    // has actually unlocked that item - the real enforcement is the
    // Firestore premiumUnlocks record (see firestore.rules), which is
    // what index.html actually checks before letting a map-maker USE an
    // item in a map; a locked item's own thumbnail is still shown in the
    // picker (see openLibraryPicker) so there'd be nothing meaningfully
    // hidden by also locking the raw file down.
    match /premium-library/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'adonai4you@gmail.com'
                   && request.auth.token.email_verified == true
                   && request.resource.size < 20 * 1024 * 1024;
    }

    // producer/{uid}/{draftId}/<file> - The Game Producer's own saved
    // drafts (producer.html). Owner-only read/write, unlike maps/library
    // above - a draft is a private in-progress project, not a published
    // game or shared asset. Higher cap than maps' own 15MB: what's
    // uploaded here is a whole STAGE's already-downloaded standalone game
    // file (itself a copy of play.html with that map's own art/sound
    // already embedded), which can easily be several times bigger than
    // any single sprite/sound maps/ was sized for.
    match /producer/{uid}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 50 * 1024 * 1024;
    }
  }
}
