rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // One document per map. Readable by anyone (a published game needs to
    // load its own map data without the viewer being signed in) but only
    // writable by the anonymous-auth user who owns it.
    match /maps/{mapId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;
    }

    // Shared asset library index (category/name/type/url per item). Public
    // read so the picker works for anonymous map-creators; write locked to
    // one specific signed-in admin account, checked off the ID token
    // itself (not a client-side flag) so it can't be spoofed.
    match /libraryItems/{itemId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'adonai4you@gmail.com'
                   && request.auth.token.email_verified == true;
    }

    // Admin-managed bonus list for the download-credit system below -
    // doc id IS the lowercased email itself (index.html/admin.html both
    // lowercase before reading/writing this, so an exists() check here
    // and a client-side membership lookup always agree). Public read is
    // required, not just convenient - the create rule on /users/{uid}
    // below has to run its OWN exists() check against this collection to
    // decide 3 vs 50, and rules can only read what the requesting user
    // is themselves allowed to read.
    match /bonusEmails/{email} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'adonai4you@gmail.com'
                   && request.auth.token.email_verified == true;
    }

    // One doc per signed-in user, tracking download credits for the "⬇
    // Download My Game" button in index.html AND The Game Producer's own
    // per-stage compile cost (producer.html - N stages spent in one
    // transaction, N >= 1, not just the single-credit download). There's
    // no backend here - this app is 100% client + these rules - so every
    // anti-cheat guarantee has to live in the rules themselves, not in
    // trusting whatever the client sends:
    //  - create: the STARTING balance must be exactly 3, or exactly 50
    //    if (and only if) this email is in bonusEmails - a client can't
    //    just create itself a doc with credits: 9999.
    //  - update: the new balance must be LOWER than the current balance
    //    and non-negative - not required to be exactly one less any
    //    more (producer.html can spend several at once for a multi-stage
    //    compile) - a client still can't increase its own balance, skip
    //    to a negative number, or spend from a balance of 0.
    //  - email is pinned to the signer's own verified token email on
    //    both create and update (can't write into someone else's uid's
    //    doc, and can't change which email a doc claims to belong to
    //    after creation).
    // The admin account never has a doc here at all - index.html and
    // producer.html both skip every credit check/decrement for that one
    // email entirely, so downloads/compiles are unlimited and untracked
    // for it, same as the "does not affect the admin" instruction that
    // created this whole system.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.auth.token.email_verified == true
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.keys().hasOnly(['email', 'credits', 'createdAt'])
                    && request.resource.data.credits ==
                        (exists(/databases/$(database)/documents/bonusEmails/$(request.auth.token.email)) ? 50 : 3)
                        + (exists(/databases/$(database)/documents/pendingCreditGrants/$(request.auth.token.email))
                            ? get(/databases/$(database)/documents/pendingCreditGrants/$(request.auth.token.email)).data.amount
                            : 0);
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.auth.token.email_verified == true
                    && request.resource.data.email == resource.data.email
                    && request.resource.data.keys().hasOnly(['email', 'credits', 'createdAt'])
                    && request.resource.data.credits >= 0
                    && request.resource.data.credits < resource.data.credits;
    }

    // admin.html's "Grant download credits" action queues a grant here,
    // by email, for an account that has never signed in yet (no uid
    // exists to credit a /users/{uid} doc directly). Only the
    // grantCredits Cloud Function (Admin SDK, bypasses these rules
    // entirely) is ever allowed to create/increase one of these docs -
    // there's deliberately no client write path at all, so nobody can
    // queue themselves free credits by writing this collection directly.
    // The doc is consumed (folded into the starting balance, then
    // deleted) by ensureUserCreditsDoc in index.html the moment that
    // email actually signs in for the first time - see the /users/{uid}
    // create rule above, which reads the amount here the same way it
    // already reads bonusEmails.
    match /pendingCreditGrants/{email} {
      allow read: if true;
      allow delete: if request.auth != null
                    && request.auth.token.email_verified == true
                    && request.auth.token.email == email;
    }

    // The Game Producer's own saved-in-progress projects (producer.html's
    // "💾 Save Draft" / "My Producer Drafts" list) - private to their
    // owner, unlike /maps above, since there's no "play a draft" public-
    // facing use case here, only "come back and keep building it" for
    // whoever made it. ownerId is pinned to the signer's own uid on
    // create and can never change on update (a client can't hand a draft
    // to a different account, or steal one by overwriting its ownerId).
    match /producerDrafts/{draftId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.ownerId;
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.ownerId
                    && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }
  }
}
